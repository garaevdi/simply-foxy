<?xml version="1.0" encoding="UTF-8" ?>
<schemalist>
  <schema id="@APP_ID@.theme_manager" path="@APP_PATH@theme_manager/">
    <key name="downloaded-sha" type="s">
      <default>""</default>
    </key>
  </schema>

  <schema id="@APP_ID@.profile">
    <key name="installed" type="b">
      <default>false</default>
    </key>
    <key name="theme-sha" type="s">
      <default>""</default>
    </key>
    <key name="button-layout" type="i">
      <range min="0" max="10"/>
      <default>0</default>
    </key>
    <key name="rounded-corners" type="b">
      <default>false</default>
    </key>
  </schema>
</schemalist>
