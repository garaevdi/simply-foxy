<?xml version="1.0" encoding="UTF-8" ?>
<schemalist>
  <schema id="@APP_ID@.theme_manager" path="@APP_PATH@theme_manager/">
    <key name="downloaded-sha" type="s">
      <default>""</default>
    </key>
  </schema>

  <enum id="@APP_ID@.layout">
    <value nick="None" value="0" />
    <value nick="Elementary" value="1" />
    <value nick="Elementary Reversed" value="2" />
  </enum>

  <schema id="@APP_ID@.profile">
    <key name="installed" type="b">
      <default>false</default>
    </key>
    <key name="theme-sha" type="s">
      <default>""</default>
    </key>
    <key name="button-layout" enum="@APP_ID@.layout">
      <default>"Elementary"</default>
    </key>
    <key name="rounded-corners" type="b">
      <default>false</default>
    </key>
  </schema>
</schemalist>
